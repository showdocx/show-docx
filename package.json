{
  "name": "show-docx",
  "displayName": "ShowDocx",
  "description": "A high-fidelity, theme-aware viewer for Word documents (.docx, .docm, .dotx, .dotm) in Visual Studio Code.",
  "version": "1.1.1",
  "publisher": "showdocx",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/showdocx/show-docx.git"
  },
  "homepage": "https://github.com/showdocx/show-docx#readme",
  "bugs": {
    "url": "https://github.com/showdocx/show-docx/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "ShowDocx renders documents in a sandboxed webview with a strict CSP. In a restricted workspace it will not open links a document points to."
    }
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "docx",
    "word",
    "office",
    "viewer",
    "preview",
    "document"
  ],
  "activationEvents": [
    "onCustomEditor:showDocx.docxViewer",
    "onLanguageModelTool:showdocx_readDocx"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "showDocx.docxViewer",
        "displayName": "Word Document Viewer",
        "selector": [
          {
            "filenamePattern": "*.{docx,docm,dotx,dotm}"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "showDocx.openWith",
        "title": "Open with ShowDocx",
        "category": "ShowDocx"
      },
      {
        "command": "showDocx.compareWithHead",
        "title": "Compare with HEAD",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer || resourceExtname == .docx || resourceExtname == .docm || resourceExtname == .dotx || resourceExtname == .dotm"
      },
      {
        "command": "showDocx.exportHtml",
        "title": "Export as HTML",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.exportMarkdown",
        "title": "Export as Markdown",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.exportPdf",
        "title": "Print to PDF (via Browser)",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.copyAsMarkdown",
        "title": "Copy as Markdown",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.copyAsText",
        "title": "Copy as Plain Text",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.search",
        "title": "Find in Document",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.searchWorkspace",
        "title": "Search in Word Documents",
        "category": "ShowDocx"
      },
      {
        "command": "showDocx.showProperties",
        "title": "Show Document Properties",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.extractImages",
        "title": "Extract Images",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer || resourceExtname == .docx || resourceExtname == .docm || resourceExtname == .dotx || resourceExtname == .dotm"
      },
      {
        "command": "showDocx.zoomIn",
        "title": "Zoom In",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.zoomOut",
        "title": "Zoom Out",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.zoomReset",
        "title": "Reset Zoom",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.fitToWidth",
        "title": "Fit Page to Width",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.fitToPage",
        "title": "Fit Whole Page",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.toggleMode",
        "title": "Toggle Visual/Text Mode",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.cyclePageTheme",
        "title": "Change Page Theme",
        "category": "ShowDocx",
        "enablement": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.showLog",
        "title": "Show Log",
        "category": "ShowDocx"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "showDocx.openWith",
          "when": "resourceExtname == .docx || resourceExtname == .docm || resourceExtname == .dotx || resourceExtname == .dotm",
          "group": "navigation@20"
        },
        {
          "command": "showDocx.compareWithHead",
          "when": "resourceExtname == .docx || resourceExtname == .docm || resourceExtname == .dotx || resourceExtname == .dotm",
          "group": "navigation@21"
        },
        {
          "command": "showDocx.extractImages",
          "when": "resourceExtname == .docx || resourceExtname == .docm || resourceExtname == .dotx || resourceExtname == .dotm",
          "group": "navigation@22"
        }
      ],
      "editor/title": [
        {
          "command": "showDocx.compareWithHead",
          "when": "activeCustomEditorId == showDocx.docxViewer",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "showDocx.searchFor",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "showDocx.search",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.zoomReset",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeCustomEditorId == showDocx.docxViewer"
      },
      {
        "command": "showDocx.exportPdf",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "activeCustomEditorId == showDocx.docxViewer"
      }
    ],
    "configuration": {
      "title": "ShowDocx",
      "properties": {
        "showDocx.defaultMode": {
          "type": "string",
          "default": "visual",
          "enum": [
            "visual",
            "text"
          ],
          "enumDescriptions": [
            "Preserve the Word page layout.",
            "Show clean, theme-aware semantic HTML."
          ],
          "description": "Default rendering mode."
        },
        "showDocx.defaultZoom": {
          "type": "number",
          "default": 100,
          "minimum": 25,
          "maximum": 400,
          "description": "Default zoom level in percent."
        },
        "showDocx.defaultPageTheme": {
          "type": "string",
          "default": "paper",
          "enum": [
            "paper",
            "sepia",
            "dark"
          ],
          "enumDescriptions": [
            "White, the way Word shows the page.",
            "A warm, low-contrast ground for long reading.",
            "Invert the page so it suits a dark editor. Images are left as they are."
          ],
          "description": "Background of the page in Visual mode. Text mode always follows the editor theme."
        },
        "showDocx.maxFileSizeMb": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum DOCX file size that ShowDocx will open."
        },
        "showDocx.autoReload": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reload the preview when the DOCX file changes on disk."
        },
        "showDocx.retainHiddenTabs": {
          "type": "boolean",
          "default": false,
          "description": "Keep a document rendered while its tab is hidden. Returning to the tab is then instant, at the cost of holding the whole document and its rendered page in memory for every open tab. Leaving this off costs one re-render on return; the reading position is restored either way. Takes effect after the window is reloaded."
        },
        "showDocx.exportLocation": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "alongside"
          ],
          "enumDescriptions": [
            "Choose where each export goes, in a save dialog.",
            "Write the export next to the document, under the same name, without asking."
          ],
          "description": "Where HTML, Markdown and printable exports are written."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "showdocx_readDocx",
        "displayName": "Read Word document",
        "toolReferenceName": "docx",
        "canBeReferencedInPrompt": true,
        "icon": "$(file-word)",
        "userDescription": "Read the text of a Word (.docx) document in this workspace.",
        "modelDescription": "Read the text content of a Word (.docx) document in the current workspace. Use this whenever you need the contents of a .docx file: reading it directly returns a binary ZIP archive, not text. Returns Markdown: headings, lists, tables and links are preserved; embedded images are replaced by a short placeholder. Deletions in tracked changes are not included, and insertions appear as accepted. Only documents inside the open workspace can be read.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Path of the .docx file, either absolute or relative to a workspace folder."
            },
            "maxCharacters": {
              "type": "number",
              "description": "Maximum number of characters to return. Defaults to 60000. If the document is longer the result is cut at a line boundary and says how much was left out."
            }
          },
          "required": [
            "filePath"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run verify && npm run build",
    "build": "node ./esbuild.mjs",
    "watch": "node ./esbuild.mjs --watch",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src shared webview-src test scripts",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test:unit": "npm run compile-tests && mocha \"dist-test/test/unit/**/*.test.js\"",
    "test:integration": "npm run build && npm run compile-tests && node ./scripts/run-tests.mjs",
    "test:webview": "npm run build && playwright test",
    "test": "npm run test:unit && npm run test:integration",
    "verify": "npm run lint && npm run check-types && npm run test:unit && npm run test:integration && npm run test:webview",
    "generate:fixtures": "node ./scripts/generate-fixtures.mjs",
    "verify:package-files": "node ./scripts/verify-package-files.mjs",
    "package": "npm run build && npm run verify:package-files && vsce package --no-dependencies",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44",
    "docx-preview": "^0.3.7",
    "dompurify": "^3.3.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.25",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "docx": "^9.7.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "mocha": "^11.3.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.0.5"
  }
}
